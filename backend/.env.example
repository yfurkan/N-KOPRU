# N-KÖPRÜ backend için isteğe bağlı yerel ayarlar.
# Bu dosyayı .env adıyla kopyalarken gerçek anahtar veya kişisel veri eklemeyin.

# SQLite dosyasının konumu. Varsayılan: backend/data/nkopru.db
# N_KOPRU_DB_PATH=D:/N-KOPRU/veri/nkopru.db

# Varsayılan değerler yerel jüri demosu için yeterlidir.
# N_KOPRU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# N_KOPRU_AI_BATCH_SIZE=4
# N_KOPRU_STANCE_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# N_KOPRU_COACH_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# N_KOPRU_COACH_FAST_PATH=1
